# Installed dependencies
.venv/

# Generated site files
/site/_data/site.json
/site/assets/data/retirements.json

# Build caches
__pycache__/
*.py[cod]

# Temporary catalog writes
/data/*.tmp

# Transient SQLite state; the four database files themselves are versioned
/data/pipeline/.lock
/data/pipeline/*.sqlite-journal
/data/pipeline/*.sqlite-wal
/data/pipeline/*.sqlite-shm

# Local configuration and logs
*.local
logs/
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json
.idea
.DS_Store
Thumbs.db
*.sw?
